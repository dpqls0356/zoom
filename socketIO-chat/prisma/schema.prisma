generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_URL")
}

model chat_rooms {
  id                    String            @id @db.Char(128)
  owner_id              String            @db.Char(128)
  max_users             Int
  created_at            DateTime?         @default(now()) @db.DateTime(0)
  profile_url           String?           @db.VarChar(255)
  room_name             String            @db.VarChar(50)
  number_of_participant Int               @default(0)
  status                chat_rooms_status @default(ACTIVE)
  deleted_at            DateTime?         @db.DateTime(0)
  chat_room_tag         chat_room_tag[]
  owner                 users             @relation(fields: [owner_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_chat_rooms_owner")
  participants          user_chat_rooms[]

  @@index([owner_id], map: "fk_chat_rooms_owner")
  @@index([status, room_name], map: "idx_chat_rooms_status_room_name")
}

model refresh_tokens {
  id         BigInt    @id @default(autoincrement())
  user_id    String    @db.Char(128)
  token      String    @db.VarChar(255)
  user_agent String?   @db.VarChar(255)
  ip_address String?   @db.VarChar(45)
  expires_at DateTime  @db.DateTime(0)
  created_at DateTime? @default(now()) @db.DateTime(0)
  revoked    Boolean?  @default(false)
  users      users     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "refresh_tokens_ibfk_1")

  @@index([user_id], map: "fk_refresh_tokens_user")
}

model user_chat_rooms {
  user_id    String     @db.Char(128)
  room_id    String     @db.Char(128)
  joined_at  DateTime?  @default(now()) @db.DateTime(0)
  chat_rooms chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ucr_room")
  user       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ucr_user")

  @@id([user_id, room_id])
  @@index([room_id], map: "fk_ucr_room")
}

model users {
  id              String            @id @db.Char(128)
  kakao_id        String            @unique(map: "kakao_id") @db.VarChar(50)
  nickname        String            @db.VarChar(50)
  profile_url     String?           @db.VarChar(255)
  created_at      DateTime?         @default(now()) @db.DateTime(0)
  user_id         String            @unique(map: "user_id") @db.VarChar(50)
  chat_rooms      chat_rooms[]
  refresh_tokens  refresh_tokens[]
  user_chat_rooms user_chat_rooms[]
}

model tags {
  id            Int             @id @default(autoincrement())
  name          String          @unique(map: "name") @db.VarChar(50)
  chat_room_tag chat_room_tag[]
}

model chat_room_tag {
  room_id   String     @db.Char(128)
  tag_id    Int
  chat_room chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_chat_room_tag_room")
  tag       tags       @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_chat_room_tag_tag")

  @@id([room_id, tag_id])
  @@index([tag_id], map: "idx_chat_room_tag_tag_id")
  @@index([tag_id, room_id], map: "idx_chat_room_tag_tag_id_room_id")
}

enum chat_rooms_status {
  ACTIVE
  DELETED
}
